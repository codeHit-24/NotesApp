<resources>
    <!-- Base App Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">#FFC1CC</item>
        <item name="colorPrimaryDark">#FF91A4</item>
        <item name="colorAccent">#0F149D</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="KuromiSearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/transparent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#BB86FC</item>
    </style>



    <!-- Custom Style for Title Text (NOTES) -->
    <style name="TitleTextStyle">
        <item name="android:textSize">60sp</item>
        <item name="android:textColor">#0F149D</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">#FFC1CC</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- Custom Style for Subtitle Text -->
    <style name="SubtitleTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#0F149D</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom Style for ADD Button -->
    <style name="AddButtonStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">87dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:backgroundTint">#FFC1CC</item>
        <item name="android:textColor">#0F149D</item>
        <item name="android:layout_marginBottom">30dp</item>
        <item name="android:shape">rectangle</item>
        <item name="cardCornerRadius">50dp</item>  <!-- Makes button round -->
    </style>
</resources>
